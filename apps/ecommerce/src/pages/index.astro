          <div>
            <small style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display:block;">Proceso Beneficio</small>
            <span id="modalProcess" style="font-size: 0.88rem; color: var(--text-primary); font-weight: 600;">-</span>
