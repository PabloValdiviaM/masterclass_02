  <!-- Script for filters & details modal -->
  <script is:inline>
    // Filters
    const filterButtons = document.querySelectorAll('.filter-btn-dark');
    const coffeeCards = document.querySelectorAll('.drink-card-dark');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        coffeeCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal
    const modal = document.getElementById('coffeeModal');
    const modalClose = document.getElementById('modalClose');
    const detailButtons = document.querySelectorAll('.btn-detail-trigger');

    const modalImg = document.getElementById('modalImg');
    const modalTitle = document.getElementById('modalTitle');
    const modalOrigin = document.getElementById('modalOrigin');
    const modalPrice = document.getElementById('modalPrice');
    const modalSpecialty = document.getElementById('modalSpecialty');
    const modalTemp = document.getElementById('modalTemp');
    const modalCategory = document.getElementById('modalCategory');
    const modalTerroir = document.getElementById('modalTerroir');
    const modalRoast = document.getElementById('modalRoast');
    const modalProcess = document.getElementById('modalProcess');
    const modalPairing = document.getElementById('modalPairing');
    const modalDesc = document.getElementById('modalDesc');
    const modalNotesList = document.getElementById('modalNotesList');

    detailButtons.forEach(button => {
      button.addEventListener('click', () => {
        const dataset = button.dataset;
        modalTitle.textContent = dataset.name;
        modalPrice.textContent = dataset.price;
        modalOrigin.textContent = dataset.origin;
        modalSpecialty.textContent = `⭐ ${dataset.specialty}`;
        modalCategory.textContent = dataset.category;
        
        modalTemp.textContent = dataset.temp === 'Caliente' ? '🔥 Caliente' : '❄️ Fría';
        modalTemp.className = `temp-badge-pill ${dataset.temp === 'Caliente' ? 'hot' : 'cold'}`;
        
        modalTerroir.textContent = dataset.origin;
        modalRoast.textContent = dataset.roast;
        modalProcess.textContent = dataset.process;
        modalPairing.textContent = dataset.pairing;
        modalDesc.textContent = dataset.desc;
        modalImg.src = dataset.image;
        modalImg.alt = dataset.name;

        modalNotesList.innerHTML = '';
        const notes = dataset.notes.split(', ');
        notes.forEach(note => {
          const pill = document.createElement('span');
          pill.style.cssText = 'background: #241A13; border: 1px solid rgba(212,163,115,0.25); color: #D4A373; font-size: 0.75rem; padding: 2px 8px; border-radius: 4px;';
          pill.textContent = note;
          modalNotesList.appendChild(pill);
        });

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
</body>
