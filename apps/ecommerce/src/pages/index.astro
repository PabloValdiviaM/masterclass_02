      <div class="footer-col">
        <h4>Horarios de Barra</h4>
        <ul>
          <li style="color: var(--text-muted); font-size: 0.88rem;">Lunes a Viernes: 07:00 - 20:30</li>
          <li style="color: var(--text-muted); font-size: 0.88rem;">Sábados y Domingos: 08:00 - 21:00</li>
          <li style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.5rem;">📍 Roastery Lab & Barra Central</li>
          <li style="color: var(--text-muted); font-size: 0.88rem;">📞 WhatsApp Barista: +1 (555) COFFEE-RAPID</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>&copy; 2026 Coffee Rapid. Todos los derechos reservados. Arquitectura Comercial Monorepo.</div>
      <div style="display: flex; gap: 1.5rem;">
        <a href="/app" style="color: var(--accent-gold); text-decoration: none; font-weight: 600;">📱 App PWA</a>
        <span>&bull;</span>
        <a href="/admin" style="color: var(--accent-gold); text-decoration: none; font-weight: 600;">⚙️ Dashboard Admin</a>
      </div>
    </div>
  </footer>

  <!-- Client-side script for filters and details modal -->
  <script is:inline>
    // Filter functionality
    const filterButtons = document.querySelectorAll('.filter-btn');
    const coffeeCards = document.querySelectorAll('.coffee-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        coffeeCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal functionality
    const modal = document.getElementById('coffeeModal');
    const modalClose = document.getElementById('modalClose');
    const detailButtons = document.querySelectorAll('.btn-detail');

    const modalImg = document.getElementById('modalImg');
    const modalTitle = document.getElementById('modalTitle');
    const modalOrigin = document.getElementById('modalOrigin');
    const modalPrice = document.getElementById('modalPrice');
    const modalSpecialty = document.getElementById('modalSpecialty');
    const modalTemp = document.getElementById('modalTemp');
    const modalCategory = document.getElementById('modalCategory');
    const modalTerroir = document.getElementById('modalTerroir');
    const modalRoast = document.getElementById('modalRoast');
    const modalProcess = document.getElementById('modalProcess');
    const modalPairing = document.getElementById('modalPairing');
    const modalDesc = document.getElementById('modalDesc');
    const modalNotesList = document.getElementById('modalNotesList');

    detailButtons.forEach(button => {
      button.addEventListener('click', () => {
        const dataset = button.dataset;
        modalTitle.textContent = dataset.name;
        modalPrice.textContent = dataset.price;
        modalOrigin.textContent = dataset.origin;
        modalSpecialty.textContent = `⭐ ${dataset.specialty}`;
        modalCategory.textContent = dataset.category;
        
        modalTemp.textContent = dataset.temp === 'Caliente' ? '🔥 Caliente' : '❄️ Fría';
        modalTemp.className = `badge-temp ${dataset.temp === 'Caliente' ? 'hot' : 'cold'}`;
        
        modalTerroir.textContent = dataset.origin;
        modalRoast.textContent = dataset.roast;
        modalProcess.textContent = dataset.process;
        modalPairing.textContent = dataset.pairing;
        modalDesc.textContent = dataset.desc;
        modalImg.src = dataset.image;
        modalImg.alt = dataset.name;

        // Render tasting notes
        modalNotesList.innerHTML = '';
        const notes = dataset.notes.split(', ');
        notes.forEach(note => {
          const pill = document.createElement('span');
          pill.className = 'note-pill';
          pill.textContent = note;
          modalNotesList.appendChild(pill);
        });

        modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = 'auto';
    }

    modalClose.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
</body>
</html>
