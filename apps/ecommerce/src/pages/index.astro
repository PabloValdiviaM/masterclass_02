---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={metaDescription} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      /* Palette Dark Premium inspirada en la referencia de diseño */
      --bg-main: #0D0907;
      --bg-surface: #140E0A;
      --bg-card: #1A120D;
      --bg-card-hover: #231811;
      --bg-card-elevated: #281D15;
      
      --text-primary: #F7EFE8;
      --text-secondary: #B8A79B;
      --text-muted: #7E6E63;
      
      --border-dark: #271A12;
      --border-subtle: rgba(212, 163, 115, 0.14);
      --border-gold: rgba(212, 163, 115, 0.38);
      
      --gold-primary: #D4A373;
      --gold-hover: #E3B486;
      --gold-deep: #B58455;
      --gold-light: rgba(212, 163, 115, 0.12);
      
      --shadow-ambient: 0 10px 40px rgba(0, 0, 0, 0.6);
      --shadow-card: 0 12px 30px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 0, 0, 0.3);
      --shadow-gold: 0 8px 24px rgba(212, 163, 115, 0.22);
      
      --radius-sm: 8px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-full: 9999px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-main);
      color: var(--text-primary);
      line-height: 1.6;
      background-image: 
        radial-gradient(circle at 15% 10%, rgba(212, 163, 115, 0.07) 0%, transparent 45%),
        radial-gradient(circle at 85% 35%, rgba(181, 132, 85, 0.05) 0%, transparent 50%),
        radial-gradient(circle at 50% 80%, rgba(212, 163, 115, 0.04) 0%, transparent 60%);
      background-attachment: fixed;
      -webkit-font-smoothing: antialiased;
    }

    /* Top Floating Notification */
    .top-floating-banner {
      background: rgba(20, 14, 10, 0.85);
      border-bottom: 1px solid var(--border-subtle);
      color: var(--text-secondary);
      padding: 0.55rem 1.5rem;
      text-align: center;
      font-size: 0.82rem;
      font-weight: 500;
      letter-spacing: 0.02em;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      backdrop-filter: blur(10px);
    }
    .top-floating-banner strong {
      color: var(--gold-primary);
      font-weight: 700;
    }

    /* Main Navigation */
    header.dark-header {
      background: rgba(13, 9, 7, 0.88);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border-dark);
      position: sticky;
      top: 0;
      z-index: 100;
      transition: all 0.3s ease;
    }
    .header-container {
      max-width: 1260px;
      margin: 0 auto;
      padding: 1.1rem 1.75rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--text-primary);
    }
    .brand-symbol {
      width: 42px;
      height: 42px;
      background: linear-gradient(135deg, #2E1F16 0%, #1A120D 100%);
      border: 1px solid var(--border-gold);
      color: var(--gold-primary);
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      box-shadow: 0 4px 14px rgba(212, 163, 115, 0.15);
    }
    .brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 1.45rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--text-primary);
      line-height: 1;
    }
    .brand-name span {
      color: var(--gold-primary);
    }
    .brand-tag {
      font-size: 0.68rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--text-muted);
      margin-top: 3px;
      display: block;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 2rem;
      list-style: none;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-secondary);
      font-size: 0.92rem;
      font-weight: 500;
      transition: color 0.2s ease;
    }
    .nav-links a:hover {
      color: var(--gold-primary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }
    .btn-gold-pill {
      background: var(--gold-primary);
      color: #140E0A;
      font-weight: 700;
      padding: 0.65rem 1.4rem;
      border-radius: var(--radius-full);
      text-decoration: none;
      font-size: 0.88rem;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.25s ease;
      box-shadow: var(--shadow-gold);
      border: 1px solid transparent;
    }
    .btn-gold-pill:hover {
      background: var(--gold-hover);
      transform: translateY(-2px);
      box-shadow: 0 10px 28px rgba(212, 163, 115, 0.35);
    }
    .btn-dark-outline {
      background: var(--bg-surface);
      color: var(--text-primary);
      border: 1px solid var(--border-dark);
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      transition: all 0.2s ease;
    }
    .btn-dark-outline:hover {
      border-color: var(--gold-primary);
      color: var(--gold-primary);
      background: var(--bg-card);
    }

    /* Hero Section Dark Luxury */
    .hero-container {
      max-width: 1260px;
      margin: 0 auto;
      padding: 4.5rem 1.75rem 3.5rem;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
      align-items: center;
    }
    .hero-pre-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(212, 163, 115, 0.08);
      border: 1px solid var(--border-subtle);
      color: var(--gold-primary);
      padding: 0.4rem 1.1rem;
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      margin-bottom: 1.5rem;
    }
    .hero-h1 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 4rem;
      font-weight: 600;
      line-height: 1.15;
      color: var(--text-primary);
      margin-bottom: 1.5rem;
      letter-spacing: -0.01em;
    }
    .hero-h1 span.gold-text {
      color: var(--gold-primary);
      font-style: italic;
    }
    .hero-paragraph {
      color: var(--text-secondary);
      font-size: 1.15rem;
      line-height: 1.7;
      margin-bottom: 2.25rem;
      max-width: 540px;
    }
    .hero-buttons {
      display: flex;
      gap: 1.1rem;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 3.5rem;
    }

    /* Floating Badges in Hero */
    .hero-graphic-wrap {
      position: relative;
    }
    .hero-img-box {
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--border-dark);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
      background: var(--bg-surface);
      position: relative;
    }
    .hero-img-box img {
      width: 100%;
      height: 480px;
      object-fit: cover;
      display: block;
      filter: contrast(1.05) brightness(0.95);
      transition: transform 0.6s ease;
    }
    .hero-img-box:hover img {
      transform: scale(1.03);
    }
    
    .floating-card-pill {
      position: absolute;
      background: rgba(26, 18, 13, 0.92);
      border: 1px solid var(--border-gold);
      backdrop-filter: blur(12px);
      padding: 0.9rem 1.25rem;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-card);
      display: flex;
      align-items: center;
      gap: 0.85rem;
      z-index: 10;
    }
    .floating-top-right {
      top: -20px;
      right: -15px;
    }
    .floating-bottom-left {
      bottom: -20px;
      left: -20px;
    }
    .pill-icon {
      font-size: 1.6rem;
      color: var(--gold-primary);
    }
    .pill-text strong {
      font-size: 0.88rem;
      color: var(--text-primary);
      display: block;
    }
    .pill-text small {
      font-size: 0.75rem;
      color: var(--gold-primary);
      font-weight: 600;
    }

    /* Section Value Props (4 Cards - as in reference) */
    .values-section {
      max-width: 1260px;
      margin: 0 auto 5rem;
      padding: 0 1.75rem;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
    .value-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-md);
      padding: 1.75rem 1.5rem;
      transition: all 0.3s ease;
    }
    .value-card:hover {
      background: var(--bg-card);
      border-color: var(--border-gold);
      transform: translateY(-4px);
      box-shadow: var(--shadow-card);
    }
    .value-icon-box {
      font-size: 1.8rem;
      color: var(--gold-primary);
      margin-bottom: 1rem;
    }
    .value-card h3 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
    }
    .value-card p {
      font-size: 0.85rem;
      color: var(--text-secondary);
      line-height: 1.55;
    }

    /* Popular Drinks Section */
    .catalog-section {
      max-width: 1260px;
      margin: 0 auto;
      padding: 2rem 1.75rem 6rem;
    }
    .section-header-centered {
      text-align: center;
      max-width: 680px;
      margin: 0 auto 3rem;
    }
    .section-kicker {
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--gold-primary);
      margin-bottom: 0.5rem;
    }
    .section-headline {
      font-family: 'Playfair Display', serif;
      font-size: 2.75rem;
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.2;
      margin-bottom: 1rem;
    }
    .section-subtext {
      color: var(--text-secondary);
      font-size: 1.05rem;
    }

    /* Category Filter Tabs */
    .filter-tabs-dark {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }
    .filter-btn-dark {
      padding: 0.65rem 1.5rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--border-dark);
      background: var(--bg-surface);
      color: var(--text-secondary);
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .filter-btn-dark.active, .filter-btn-dark:hover {
      background: var(--gold-primary);
      color: #140E0A;
      border-color: var(--gold-primary);
      font-weight: 700;
      box-shadow: 0 4px 14px rgba(212, 163, 115, 0.25);
    }

    /* Cards Grid - Dark Premium Aesthetic (matches the reference screenshot) */
    .drinks-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }
    .drink-card-dark {
      background: var(--bg-card);
      border: 1px solid var(--border-dark);
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-card);
      transition: all 0.3s ease;
      position: relative;
    }
    .drink-card-dark:hover {
      background: var(--bg-card-hover);
      border-color: var(--border-gold);
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(212, 163, 115, 0.08);
    }

    .drink-img-wrap {
      position: relative;
      height: 220px;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: #140D09;
      margin-bottom: 1.25rem;
    }
    .drink-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .drink-card-dark:hover .drink-img-wrap img {
      transform: scale(1.05);
    }
    
    .rating-badge-pill {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(255, 255, 255, 0.95);
      color: #140E0A;
      font-weight: 800;
      font-size: 0.78rem;
      padding: 3px 9px;
      border-radius: var(--radius-full);
      display: flex;
      align-items: center;
      gap: 3px;
