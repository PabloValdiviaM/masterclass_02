          <button class="filter-btn active" data-filter="all">☕ Todas las Bebidas (10)</button>
          <button class="filter-btn" data-filter="Bebidas Calientes">🔥 Bebidas Calientes (6)</button>
          <button class="filter-btn" data-filter="Bebidas Frías">❄️ Bebidas Frías (4)</button>
        </div>

        <!-- Coffees Grid -->
        <div class="coffees-grid">
          {featuredCoffees.map((coffee) => (
            <div class="coffee-card" data-category={coffee.category}>
              <div class="card-img-wrap">
                <img src={coffee.image} alt={coffee.name} loading="lazy" />
                <div class="card-badges">
                  <span class={`badge-temp ${coffee.temperature === 'Caliente' ? 'hot' : 'cold'}`}>
                    {coffee.temperature === 'Caliente' ? '🔥 Caliente' : '❄️ Fría'}
                  </span>
                  <span class="badge-sca">
                    ⭐ {coffee.specialtyLevel.split(' ')[1]} {coffee.specialtyLevel.split(' ')[2] || 'SCA'}
                  </span>
                </div>
              </div>

              <div class="card-body">
                <div class="card-title-row">
                  <h3 class="coffee-title">{coffee.name}</h3>
                  <div class="coffee-origin">
                    <span>📍</span>
                    <span>{coffee.origin.split(',')[0]}</span>
                  </div>
                </div>

                <p class="coffee-desc">{coffee.description}</p>

                <div class="coffee-notes">
                  {coffee.notes.map((note) => (
                    <span class="note-pill">{note}</span>
                  ))}
                </div>

                <div class="card-footer">
                  <div class="price-wrap">
                    <span class="price-label">Precio</span>
                    <span class="price-value">{coffee.price}</span>
                  </div>

                  <button
                    class="btn-detail"
                    data-id={coffee.id}
                    data-name={coffee.name}
                    data-price={coffee.price}
                    data-category={coffee.category}
                    data-temp={coffee.temperature}
                    data-specialty={coffee.specialtyLevel}
                    data-origin={coffee.origin}
                    data-process={coffee.process}
                    data-roast={coffee.roast}
                    data-notes={coffee.notes.join(', ')}
                    data-desc={coffee.description}
                    data-pairing={coffee.pairing}
                    data-image={coffee.image}
                  >
                    <span>Ver detalles</span>
                    <span>→</span>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PWA Callout -->
    <section class="container" id="app-mobile">
